# FiReport backend env — copy to .env (chmod 600), fill in your own values
# NASA FIRMS map key (free): https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=your_firms_map_key
# Apple MapKit JS — from Apple Developer › Certificates, IDs & Profiles › Maps
APPLE_MAPS_KEY_PATH=/opt/fireport/backend/MapsKey.p8
APPLE_MAPS_KEY_ID=YOUR_KEY_ID
APPLE_MAPS_TEAM_ID=YOUR_TEAM_ID
MAPKIT_ORIGIN=https://your-domain.example
FRANCE_BBOX=-5,41,10,52
